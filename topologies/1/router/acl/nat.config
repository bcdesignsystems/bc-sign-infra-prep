enable 
configure terminal 
access-list 1 permit 192.168.20.0 0.0.0.15
access-list 1 permit 192.168.21.0 0.0.0.15
access-list 1 permit 192.168.30.0 0.0.0.15
end
write memory
configure terminal
! Tu regardes l'ACL pour savoir quelles sont les addresses IP 
! qui traversent l'interface interne et qui sont autorisées
! à bénéficier de la surcharge de l'adresses IP publique du routeur
ip nat inside source list 1 interface GigabitEthernet0/0/0 overload
end 
write memory