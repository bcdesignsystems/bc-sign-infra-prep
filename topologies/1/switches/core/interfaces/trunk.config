enable
configure terminal
switchport mode trunk / allowed 20,21,30
(ports vers Switch0, Switch1, CORE-2)

interface range gi 1/0/1 - 2
switchport mode trunk
switchport trunk allowed vlan 20,21,30
no shutdown
exit
interface  gi 1/0/8
switchport mode trunk
switchport trunk allowed vlan 20,21,30
end
write memory