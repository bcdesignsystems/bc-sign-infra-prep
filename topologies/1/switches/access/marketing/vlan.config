enable
configure terminal
vlan 20
name RH
vlan 21 
name MARKETING
vlan 30
name SERVEURS
end
write memory

enable
configure terminal
interface range fa0/1 - 2
switchport mode access
switchport access vlan 21
no shutdown
end

enable
configure terminal
interface  fa0/3
switchport mode access
switchport access vlan 30
no shutdown
end
