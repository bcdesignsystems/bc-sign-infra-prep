# sur switch marketing
enable
configure terminal
interface range Fa0/1-2
switchport mode access
switchport access vlan 20 
exit
interface gig0/1
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 20,21,999
exit
end
write memory

# sur switch RH
enable
configure terminal
interface range Fa0/1-2
switchport mode access
switchport access vlan 21
exit
interface gig0/1
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 20,21,999 # on utilise trunk et pas access
exit                                    # car on a 3 vlan a faire passer
end
write memory