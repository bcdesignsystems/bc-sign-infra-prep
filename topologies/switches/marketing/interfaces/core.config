enable
configure terminal
interface Gi0/1
switchport mode access
switchport access vlan 20
no shutdown
exit
end 
write memory

enable
configure terminal
interface gig1/0/1
 switchport trunk encapsulation dot1q # manière d'étiqueter les trames sur le trunk
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 20,21,999
exit
