# vlan 20 = marketing
enable
configure terminal
interface Gi0/1
switchport mode access
switchport access vlan 20
no shutdown
exit
end 
write memory

# vlan 21 = rh
enable
configure terminal
interface Gi0/1
switchport mode access
switchport access vlan 21
no shutdown
exit
end 
write memory

enable
configure terminal
interface gig1/0/1
 switchport trunk encapsulation dot1q # manière d'étiqueter les trames sur le trunk
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 20,21,999
exit
interface gig1/0/2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 20,21,999
exit
